<launch>
  <!-- Play the ROS bag file -->

    <!-- Launch rqt dashboard -->
  <node name="my_rqt_dashboard" pkg="rqt_gui" type="rqt_gui" respawn="false" output="screen"
    args="--perspective-file $(find fast_dynamic)/launch/motion_compensate.perspective"/>
  
  <!-- -s 24.8 /home/x-yq/catkin_ws/bags/dynamic_6dof.bag -->
  <!-- -s 0. /home/x-yq/catkin_ws/bags/IROS_Dataset/what_is_background/background.bag -->
  <!-- -s 1.05 /home/x-yq/catkin_ws/bags/event_detector/test_vins.bag -->
  <!-- -s 0. /home/x-yq/catkin_ws/bags/slider_depth.bag -->
  <!-- -s 0. /home/x-yq/catkin_ws/bags/simulation_3planes.bag-->


  <node pkg="rosbag" type="play" name="player" respawn="false"
  args="-r 0.1 -d 1.0 -s 0. /home/x-yq/catkin_ws/bags/slider_depth.bag"/>

  <!-- Publish PointStamped from PointStampedArray -->
  <node pkg="fast_dynamic" type="fast_dynamic" name="motion_compensate" output="screen" respawn="false">
    <param name="num_events_map_update" value="50000" />
    <param name="acc_threshold" value="0.0001" />
    <param name="lr_x" value="10." />
    <param name="lr_y" value="10." />
    <param name="lr_div" value="0.0001" />
    <param name="lr_rot" value="0.0001" />
    <param name="tm_max_iter" value="1000" />
    <param name="filter_threshold" value="0.3" />
    
    <param name="depth_patch_height" value="18" />
    <param name="depth_patch_width" value="24" />

    <param name="use_adam" value="false"/>
    <param name="enable_undistort" value="false"/>
    <param name="filter_small_compo" value="true"/>
    <param name="save_frames" value="false"/>
    <param name="plot_hist" value="true"/>
    <param name="better_initial" value="false"/>
    <param name="random_initial" value = "true"/>
    <param name="enable_depth" value="false"/>
    <param name="bag_args" value="-r 0.1 -d 1.0 -s 0. /home/x-yq/catkin_ws/bags/simulation_3planes.bag"/>
    <param name="bag_ind" value="1"/>
    <!-- 0:test_vins   1:slider_depth  2:simulation_3planes -->

    <remap from="events" to="/dvs/events" />
    <remap from="event_image" to="event_image" />
    <remap from="depth_image" to="/dvs/depthmap" />
    <!-- <remap from="depth_image" to="/camera/depth/image_rect_raw" /> -->
    <!-- <remap from="imu_data" to="/mavros/imu/data" /> -->

  </node>
  <!-- Render events and frames -->
  <node name="dvs_displayer_one" pkg="dvs_displayer" type="dvs_displayer" output="screen" respawn="false">
    <param name="display_method" value="red-blue"/>
    <remap from="events" to="/dvs/events" />
    <remap from="event_image" to="event_image" />
  </node>

</launch>